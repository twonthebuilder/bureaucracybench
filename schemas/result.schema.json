{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/twonthebuilder/bureaucracybench/schemas/result.schema.json",
  "title": "result.schema.json",
  "description": "Draft contract; version 0.1.0-draft. Cross-record invariants require loader validation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "run_id": {
      "type": "string"
    },
    "sample_id": {
      "type": "string"
    },
    "benchmark_version": {
      "type": "string"
    },
    "corpus_id": {
      "type": "string"
    },
    "corpus_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "case_id": {
      "type": "string"
    },
    "case_revision": {
      "type": "string"
    },
    "case_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_variant_id": {
      "type": "string"
    },
    "rendered_prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixture_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "reference_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "repetition": {
      "type": "integer",
      "minimum": 0
    },
    "code_commit": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "string"
    },
    "model_profile_id": {
      "type": "string"
    },
    "requested_model": {
      "type": "string"
    },
    "returned_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "api_surface": {
      "type": "string"
    },
    "endpoint_identity": {
      "type": "string"
    },
    "provider_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "local_metadata": {
      "type": [
        "object",
        "null"
      ]
    },
    "requested_settings": {
      "type": "object"
    },
    "transmitted_settings": {
      "type": "object"
    },
    "confirmed_settings": {
      "type": "object"
    },
    "setting_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "raw_output": {
      "type": [
        "string",
        "null"
      ]
    },
    "finish_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "refused",
        "truncated",
        "error",
        "incompatible",
        "skipped",
        "context_overflow",
        "max_turns"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "attempt_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cache": {
      "type": "object",
      "properties": {
        "hit": {
          "type": "boolean"
        },
        "source_sample_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hit",
        "source_sample_id"
      ],
      "additionalProperties": false
    },
    "latency_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "time_to_first_token_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "generation_tokens_per_second": {
      "type": [
        "number",
        "null"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "enum": [
            "provider",
            "runtime",
            "estimate",
            "unknown"
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cached_input_tokens",
        "source"
      ],
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "actual",
            "estimated",
            "unknown"
          ]
        },
        "pricing_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "pricing_date": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "amount",
        "currency",
        "mode",
        "pricing_source",
        "pricing_date"
      ],
      "additionalProperties": false
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "method": {
            "enum": [
              "deterministic",
              "reference",
              "human_rubric",
              "llm_judge"
            ]
          },
          "status": {
            "enum": [
              "assessed",
              "not_applicable",
              "unassessed",
              "parse_error",
              "evaluator_error"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "scale": {
            "type": [
              "object",
              "null"
            ]
          },
          "numerator": {
            "type": [
              "number",
              "null"
            ]
          },
          "denominator": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "source_id",
                "locator",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "judgment_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "version",
          "dimension",
          "method",
          "status",
          "value",
          "scale",
          "numerator",
          "denominator",
          "evidence",
          "rationale",
          "judgment_id"
        ],
        "additionalProperties": false
      }
    },
    "dimension_summaries": {
      "type": "object"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "planned_criteria": {
          "type": "integer",
          "minimum": 0
        },
        "assessed_criteria": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "planned_criteria",
        "assessed_criteria"
      ],
      "additionalProperties": false
    },
    "raw_response_artifact": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "sample_id",
    "benchmark_version",
    "corpus_id",
    "corpus_manifest_sha256",
    "case_id",
    "case_revision",
    "case_sha256",
    "prompt_variant_id",
    "rendered_prompt_sha256",
    "fixture_sha256",
    "reference_sha256",
    "repetition",
    "code_commit",
    "timestamp",
    "provider",
    "model_profile_id",
    "requested_model",
    "returned_model",
    "model_revision",
    "api_surface",
    "endpoint_identity",
    "provider_request_id",
    "provider_fingerprint",
    "local_metadata",
    "requested_settings",
    "transmitted_settings",
    "confirmed_settings",
    "setting_warnings",
    "messages",
    "raw_output",
    "finish_reason",
    "status",
    "error",
    "attempt_ids",
    "cache",
    "latency_ms",
    "time_to_first_token_ms",
    "generation_tokens_per_second",
    "usage",
    "cost",
    "evaluations",
    "dimension_summaries",
    "coverage",
    "raw_response_artifact"
  ],
  "additionalProperties": false
}
